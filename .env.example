# ============================================================
# astock_ai 环境变量示例
# 复制为 .env 后填入真实值。.env 不要提交到版本库。
# ============================================================

# ---- DeepSeek（AI 报告 / 复盘归因，Phase 2 起启用）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Token 预算护栏（超过后自动降级为本地模板报告）----
LLM_ENABLED=false
LLM_DAILY_TOKEN_BUDGET=200000

# ---- 覆盖配置文件中的路径（可选）----
# ASTOCK_DATA_DIR=e:/星空系统/astock_ai/data
